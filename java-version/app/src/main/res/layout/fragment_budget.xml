<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDF8F0"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="预算管理"
        android:textSize="20sp"
        android:textColor="#4A3728"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_budget_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本月未设置预算"
        android:textSize="16sp"
        android:textColor="#4A3728"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_budget_amount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="设置月度预算金额"
        android:inputType="numberDecimal"
        android:background="@drawable/edit_text_bg"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_save_budget"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="保存预算"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E8915B"/>

</LinearLayout>
